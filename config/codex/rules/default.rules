# Claude の permissions（config/claude/settings.json）を Codex の execpolicy に写したもの。
# allow: sandbox 外での実行を自動承認 / prompt: 毎回確認 / forbidden: 拒否
# 検証: codex execpolicy check --rules config/codex/rules/default.rules -- <command>

# ---- ask -> prompt（リモートや履歴を変更する操作） ----
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "リモートへ書き込むため確認")
prefix_rule(pattern = ["git", "commit"], decision = "prompt", justification = "履歴を変更するため確認")
prefix_rule(pattern = ["git", "rebase"], decision = "prompt", justification = "履歴を変更するため確認")
prefix_rule(pattern = ["gh", "pr", "create"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "pr", "close"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "pr", "edit"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "issue", "create"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "issue", "close"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "issue", "edit"], decision = "prompt", justification = "GitHub へ書き込むため確認")
prefix_rule(pattern = ["gh", "repo", "create"], decision = "prompt", justification = "GitHub へ書き込むため確認")

# ---- deny -> forbidden ----
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "sudo は使用不可")
prefix_rule(pattern = ["rm"], decision = "forbidden", justification = "rm は使用不可。trash を使う")
prefix_rule(pattern = ["git", "reset"], decision = "forbidden", justification = "git reset は使用不可")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "forbidden", justification = "取り返しがつかない")
prefix_rule(pattern = ["wget"], decision = "forbidden", justification = "wget は使用不可。curl を使う")
prefix_rule(pattern = ["nc"], decision = "forbidden", justification = "nc は使用不可")
prefix_rule(pattern = ["npm", "uninstall"], decision = "forbidden", justification = "依存の削除は手動で行う")
prefix_rule(pattern = ["npm", "remove"], decision = "forbidden", justification = "依存の削除は手動で行う")
prefix_rule(pattern = ["pnpm", "uninstall"], decision = "forbidden", justification = "依存の削除は手動で行う")
prefix_rule(pattern = ["pnpm", "remove"], decision = "forbidden", justification = "依存の削除は手動で行う")
prefix_rule(pattern = ["psql"], decision = "forbidden", justification = "DB クライアントは直接使用しない")
prefix_rule(pattern = ["mysql"], decision = "forbidden", justification = "DB クライアントは直接使用しない")
prefix_rule(pattern = ["mongod"], decision = "forbidden", justification = "DB サーバーは直接起動しない")

# ---- allow ----
prefix_rule(pattern = ["eza"], decision = "allow")
prefix_rule(pattern = ["bat"], decision = "allow")
prefix_rule(pattern = ["fd"], decision = "allow")
prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["trash"], decision = "allow")
prefix_rule(pattern = ["trash-put"], decision = "allow")
prefix_rule(pattern = ["jq"], decision = "allow")
prefix_rule(pattern = ["gh", "status"], decision = "allow")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow", match = ["gh pr view 12", "gh pr view --repo owner/repo"], not_match = ["gh pr --repo owner/repo view 12"])
prefix_rule(pattern = ["gh", "pr", "diff"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "view"], decision = "allow")
prefix_rule(pattern = ["echo"], decision = "allow")
prefix_rule(pattern = ["touch"], decision = "allow")
prefix_rule(pattern = ["mkdir"], decision = "allow")
prefix_rule(pattern = ["cp"], decision = "allow")
prefix_rule(pattern = ["man"], decision = "allow")
prefix_rule(pattern = ["npm", "run"], decision = "allow")
prefix_rule(pattern = ["npm", "test"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run"], decision = "allow")
prefix_rule(pattern = ["pnpm", "test"], decision = "allow")
prefix_rule(pattern = ["yarn", "run"], decision = "allow")
prefix_rule(pattern = ["yarn", "test"], decision = "allow")
prefix_rule(pattern = ["bun", "run"], decision = "allow")
prefix_rule(pattern = ["bun", "test"], decision = "allow")
prefix_rule(pattern = ["curl"], decision = "allow")
prefix_rule(pattern = ["hunk", "session"], decision = "allow")
prefix_rule(pattern = ["hunk", "skill"], decision = "allow")
prefix_rule(pattern = ["hunk", "diff"], decision = "allow")
prefix_rule(pattern = ["hunk", "show"], decision = "allow")
prefix_rule(pattern = ["nix", "develop", "-c"], decision = "allow")
