{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read(~/Projects/**/*)",
      "Read(~/.config/**/*)",
      "Read(~/.local/**/*)",
      "Read(~/.claude/**/*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(trash:*)",
      "Bash(trash-put:*)",
      "Bash(jq:*)",
      "Bash(gh status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(echo:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(man:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn run:*)",
      "Bash(yarn test:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(curl:*)",
      "Bash(hunk session:*)",
      "Bash(hunk skill:*)",
      "Bash(hunk diff:*)",
      "Bash(hunk show:*)",
      "Bash(nix develop -c:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(git reset:*)",
      "Bash(gh repo delete:*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.token)",
      "Read(**/*token*.json)",
      "Read(**/.env.*)",
      "Edit(**/.env*)",
      "Edit(**/secrets/**)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(pnpm uninstall:*)",
      "Bash(pnpm remove:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh repo create:*)"
    ],
    "defaultMode": "plan"
  },
  "model": "claude-fable-5-1[1m]",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "(~/.claude/hooks/notify.sh 'Awaiting Confirmation...' &)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/report-herdr-state.sh blocked"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.claude/logs && echo \"[$(date '+%H:%M:%S')] $USER: $(jq -r '.tool_input.command')\" >> ~/.claude/logs/command_history_$(date '+%Y-%m-%d').log"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/report-herdr-state.sh working"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/block-dangerous.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-piped.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/report-herdr-state.sh unknown"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/yu-sz/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "find ~/.claude/logs -name 'command_history_*.log' -mtime +30 -delete 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(~/.claude/hooks/notify.sh 'Task Completed!' &)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/report-herdr-state.sh idle"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/report-herdr-state.sh working"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "bash-lsp@dotfiles-lsp": true,
    "example-skills@anthropic-agent-skills": true,
    "gopls-lsp@dotfiles-lsp": true,
    "lua-lsp@claude-plugins-official": false,
    "lua-lsp@dotfiles-lsp": true,
    "nixd-lsp@dotfiles-lsp": true,
    "rust-analyzer-lsp@dotfiles-lsp": true,
    "terraform-lsp@dotfiles-lsp": true,
    "vtsls-lsp@dotfiles-lsp": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "dotfiles-lsp": {
      "source": {
        "source": "directory",
        "path": "~/Projects/dotfiles"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "showClearContextOnPlanAccept": true,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754030471611
  }
}
